{
  "info": {
    "_postman_id": "7b2e12d1-54d2-4b8b-9ad7-4b0b5ecb12a1",
    "name": "Client Photo Selection Gallery - All APIs",
    "description": "Run requests in the displayed order. First set adminEmail/adminPassword from your .env and run npm run seed-admin. Then start the server. Admin Login saves adminToken automatically. Create Gallery saves galleryId and folderToken. Create Client Access generates a fresh username for each run and saves clientAccessId; Client Login is placed immediately after it and saves clientToken. Create Folder saves folderId. Upload Photos requires selecting a local image file in the photos form-data field and working Cloudinary credentials. Selection APIs require an uploaded photo. Keep Archive Gallery, Delete Folder and Delete Photo for cleanup/testing only after the other requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000",
      "type": "string"
    },
    {
      "key": "adminEmail",
      "value": "admin@example.com",
      "type": "string"
    },
    {
      "key": "adminPassword",
      "value": "ChangeThisPassword123",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "clientToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "galleryId",
      "value": "",
      "type": "string"
    },
    {
      "key": "folderToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "clientUsername",
      "value": "client_ava",
      "type": "string"
    },
    {
      "key": "clientPassword",
      "value": "ClientPass123",
      "type": "string"
    },
    {
      "key": "clientAccessId",
      "value": "",
      "type": "string"
    },
    {
      "key": "folderId",
      "value": "",
      "type": "string"
    },
    {
      "key": "photoId",
      "value": "",
      "type": "string"
    },
    {
      "key": "testFolderName",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Authentication",
      "item": [
        {
          "name": "Admin Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/admin/login",
            "description": "Log in with the admin account created by seed-admin. Saves adminToken automatically.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) { const j = pm.response.json(); if (j.token) pm.collectionVariables.set('adminToken', j.token); }",
                  "pm.test('Admin login succeeded', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code !== 200) console.log('Check adminEmail/adminPassword collection variables and run npm run seed-admin first.');"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Galleries (Admin)",
      "item": [
        {
          "name": "Create Gallery",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/galleries",
            "description": "Creates a gallery. Automatically saves galleryId and folderToken.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Wedding Gallery\",\n  \"clientName\": \"Ava\",\n  \"description\": \"Wedding photos\",\n  \"selectionLimit\": 50\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) { const j=pm.response.json(); if(j.gallery && j.gallery._id) pm.collectionVariables.set('galleryId',j.gallery._id); if(j.gallery && j.gallery.folderToken) pm.collectionVariables.set('folderToken',j.gallery.folderToken); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Get All Galleries",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/galleries",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Get Gallery by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/galleries/{{galleryId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Update Gallery",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/galleries/{{galleryId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Wedding Gallery Updated\",\n  \"clientName\": \"Ava\",\n  \"description\": \"Updated description\",\n  \"selectionLimit\": 60\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "03 - Client Access",
      "item": [
        {
          "name": "Create Client Access",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/client-access",
            "description": "Creates client credentials. Username must be globally unique; password minimum 8 characters.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"galleryId\": \"{{galleryId}}\",\n  \"username\": \"{{clientUsername}}\",\n  \"password\": \"{{clientPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const runId = Date.now().toString().slice(-8);",
                  "pm.collectionVariables.set('clientUsername', 'client_' + runId);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) { const j=pm.response.json(); if(j.client && j.client.id) pm.collectionVariables.set('clientAccessId',j.client.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Client Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/client/login",
            "description": "Use the private folderToken returned when creating a gallery, plus client credentials. Saves clientToken automatically.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{folderToken}}\",\n  \"username\": \"{{clientUsername}}\",\n  \"password\": \"{{clientPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) { const j = pm.response.json(); if (j.token) pm.collectionVariables.set('clientToken', j.token); }",
                  "pm.test('Client login succeeded', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code !== 200) console.log('Run Create Gallery and Create Client Access first; verify folderToken, username and password.');"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Clients for Gallery",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/client-access/gallery/{{galleryId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Get My Gallery (Client)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/client-access/gallery",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{clientToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Update Client Active Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/client-access/{{clientAccessId}}/status",
            "description": "Set isActive to false to disable; true to enable.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isActive\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "04 - Folders",
      "item": [
        {
          "name": "Create Folder",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/galleries/{{galleryId}}/folders",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{testFolderName}}\",\n  \"description\": \"Ceremony photos\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const runId = Date.now().toString().slice(-8);",
                  "pm.collectionVariables.set('testFolderName', 'Wedding Ceremony ' + runId);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) { const j=pm.response.json(); if(j.folder && j.folder._id) pm.collectionVariables.set('folderId',j.folder._id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Gallery Folders (Admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/admin/galleries/{{galleryId}}/folders",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Get Gallery Folders (Client)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/client/galleries/{{galleryId}}/folders",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{clientToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Update Folder",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/folders/{{folderId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Wedding Ceremony Updated\",\n  \"description\": \"Updated folder description\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "05 - Photos",
      "item": [
        {
          "name": "Upload Photos",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/galleries/{{galleryId}}/folders/{{folderId}}/photos",
            "description": "Body type: form-data. Add one or more rows with key photos and type File. Allowed: JPG, PNG, WEBP, GIF, HEIC, TIFF; max 15 MB each, 30 files.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "photos",
                  "type": "file",
                  "src": ""
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) { const j=pm.response.json(); if(j.photos && j.photos.length) pm.collectionVariables.set('photoId',j.photos[0]._id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Gallery Photos (Client)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/galleries/{{galleryId}}/photos",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{clientToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Get Gallery Photos (Admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/admin/galleries/{{galleryId}}/photos",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Get Photos by Folder (Client)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/galleries/{{galleryId}}/photos?folderId={{folderId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{clientToken}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "06 - Client Selections",
      "item": [
        {
          "name": "Save My Selection",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/selections/mine",
            "description": "Replace the client selection with the supplied photo IDs. Requires at least one photo and respects gallery selectionLimit.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{clientToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"photoIds\": [\n    \"{{photoId}}\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Submit My Selection",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/selections/mine/submit",
            "description": "Submits the saved selection. Save at least one photo first.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{clientToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Get My Selection",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/selections/mine",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{clientToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Get a Client Selection (Admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/selections/{{galleryId}}/clients/{{clientAccessId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Download Client Selection ZIP (Admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/selections/{{galleryId}}/clients/{{clientAccessId}}/download",
            "description": "Downloads original selected photos as a ZIP. Optional folder filter: add ?folderId={{folderId}}.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "07 - Cleanup (run last)",
      "item": [
        {
          "name": "Archive Gallery",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/galleries/{{galleryId}}",
            "description": "Archives the gallery and disables its client accounts. Run this last because it disables client access.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Delete Folder",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/folders/{{folderId}}",
            "description": "Deletes the folder record; photos remain in the gallery without a folder. Run after photo/selection tests.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Delete Photo",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/galleries/{{galleryId}}/photos/{{photoId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}