<%# Admin review page for client selections and their downloadable photo archive. %>
<%- include('../partials/head', { pageTitle: 'Client Selections' }) %>
<body data-gallery-id="<%= galleryId %>" data-client-access-id="<%= clientAccessId %>">
    <main class="workspace">
        <header class="page-heading">
            <div>
                <a href="/admin/dashboard" class="back-link">← Dashboard</a>
                <p class="eyebrow">CLIENT PROOFING</p>
                <h1>Photo selections</h1>
                <p id="clientName" class="muted">Loading client selections...</p>
            </div>
            <button id="download" class="primary" type="button" disabled>Download selected ZIP</button>
        </header>
        <section class="content-card">
            <div class="section-heading"><h2 id="summary">Selections</h2><span id="status" class="status">Pending</span></div>
            <div id="photos" class="photo-grid">Loading selections...</div>
        </section>
    </main>
    <%- include('../partials/footer', { pageScript: '/js/admin-selections.js' }) %>
