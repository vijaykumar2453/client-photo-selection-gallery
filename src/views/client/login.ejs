<%# Client sign-in form for opening a private photo gallery. %>
<%# Client sign-in uses the private gallery token embedded in the link. %>
<%- include('../partials/head', { pageTitle: 'Client Login' }) %>
<body class="auth-page" data-private-token="<%= token || '' %>">
    <main class="auth-card">
        <%- include('../partials/brand', { brandHref: '/' }) %>
        <p class="eyebrow">YOUR PRIVATE GALLERY</p>
        <h1>Your photos await</h1>
        <p class="muted">Sign in with the credentials provided by your photographer.</p>
        <form id="loginForm">
            <label for="username">Username</label>
            <input id="username" name="username" autocomplete="username" required>
            <label for="password">Password</label>
            <input id="password" name="password" type="password" autocomplete="current-password" required>
            <button class="primary full" type="submit">Open gallery</button>
            <p id="message" class="message" role="status"></p>
        </form>
    </main>
    <%- include('../partials/footer', { pageScript: '/js/client-login.js' }) %>
