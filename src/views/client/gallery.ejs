<%# Client gallery for browsing folders, choosing favorites, and submitting selections. %>
<%- include('../partials/head', { pageTitle: 'Your Gallery' }) %>
<body>
    <main class="workspace">
        <header class="page-heading">
            <div>
                <%- include('../partials/brand', { brandHref: '/client/gallery' }) %>
                <p class="eyebrow">YOUR PRIVATE GALLERY</p>
                <h1 id="galleryTitle">Your photographs</h1>
                <p id="galleryDescription" class="muted">Choose your favourites.</p>
            </div>
            <button id="logout" class="outline" type="button">Log out</button>
        </header>
        <section class="content-card">
            <div class="section-heading">
                <div><p class="eyebrow">YOUR ALBUM</p><h2 id="folderHeading">All folders</h2></div>
                <span id="count" class="status">0 selected</span>
            </div>
            <div id="folders" class="folder-grid"></div>
            <div class="selection-toolbar">
                <span id="limitText" class="muted"></span>
                <div class="selection-actions">
                    <span id="draftStatus" class="muted" role="status">Draft saved</span>
                    <button id="saveDraft" class="outline" type="button" disabled>Save draft</button>
                    <button id="submit" class="primary" type="button">Submit final selections</button>
                </div>
            </div>
            <p id="message" class="message" role="status"></p>
            <div id="photos" class="photo-grid">Loading your photos...</div>
            <button id="loadMore" class="outline load-more hidden" type="button">Load more photos</button>
        </section>
    </main>
    <%- include('../partials/footer', { pageScript: '/js/client-gallery.js' }) %>